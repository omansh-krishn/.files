// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "pop_on_backspace": true,
   "activate_on_single_click": true,
   "search_files_in_root": false,
   "font": {
      "normal": {
         "family": "SF Pro Display",
         "size": 14
      }
   },
   "theme": {
      "dark": {
         "name": "ayu-dark",
         "icon_theme": "Tela green"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 0.98,
      "client_side_decorations": {
         "enabled": true
      }
   },
   "favorites": [
      "applications:org.localsend.localsend_app",
      "applications:helium",
      "applications:kitty"
   ],
   "providers": {
      "@elliotdes/store.raycast.google-tasks": {
         "entrypoints": {
            "create-task": {
               "alias": "ctask"
            },
            "view-lists": {
               "alias": "vtasks"
            }
         }
      },
      "applications": {
         "enabled": true,
         "preferences": {
            "paths": [
               "/home/omansh-krishn/.local/share/applications",
               "/usr/share/applications"
            ]
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "calculator": {
         "enabled": true,
         "preferences": {
            "backend": "qalculate",
            "refreshRatesOnStartup": false
         }
      },
      "clipboard": {
         "enabled": true,
         "preferences": {
            "encryption": false,
            "eraseOnStartup": false,
            "ignorePasswords": true,
            "monitoring": true
         },
         "entrypoints": {
            "history": {
               "alias": "clip"
            }
         }
      },
      "core": {
         "enabled": true,
         "entrypoints": {
            "about": {
               "enabled": false
            },
            "documentation": {
               "enabled": false
            },
            "forget-telemetry": {
               "enabled": false
            },
            "inspect-local-storage": {
               "enabled": true
            },
            "list-extensions": {
               "enabled": false
            },
            "prune-memory": {
               "alias": "vc-prune-mem"
            },
            "refresh-apps": {
               "alias": "vc-apps-refresh"
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-emojis": {
               "alias": "emoji"
            },
            "settings": {
               "alias": "settings"
            },
            "sponsor": {
               "enabled": false
            },
            "store": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "preferences": {
            "autoIndexing": false,
            "excludedPaths": "",
            "paths": "/home/omansh-krishn",
            "watcherPaths": ""
         }
      },
      "font": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": true
      },
      "power": {
         "entrypoints": {
            "hibernate": {
               "enabled": false
            },
            "lock": {
               "alias": "lock"
            },
            "logout": {
               "alias": "log out"
            },
            "power-off": {
               "alias": "shut down"
            },
            "reboot": {
               "alias": "reboot"
            },
            "sleep": {
               "alias": "sleep"
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "alias": "sleep",
               "enabled": false
            }
         }
      },
      "raycast-compat": {
         "enabled": false
      },
      "shortcuts": {
         "enabled": false
      },
      "system": {
         "enabled": true,
         "entrypoints": {
            "browse-apps": {
               "enabled": true
            },
            "run": {
               "alias": "run"
            }
         }
      },
      "theme": {
         "enabled": true
      },
      "wm": {
         "enabled": true
      }
   }
}