# if you are using runit is suggested that you keep this one
# and rename /etc/logrotate.d/rsyslog to /etc/logrotate.d/rsyslog.disabled
# to silence the logrotate error; see #1092031
/var/log/syslog
/var/log/mail.log
/var/log/kern.log
/var/log/auth.log
/var/log/user.log
/var/log/cron.log
{
	rotate 4
	weekly
	missingok
	notifempty
	compress
	delaycompress
	sharedscripts
	postrotate
		for f in /usr/lib/rsyslog/*; do "$f" ; done
	endscript
}
