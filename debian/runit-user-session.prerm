#!/bin/sh
set -e

if [ "$1" = remove ]; then
	if [ -e /usr/sbin/pam-auth-update ]; then #no pam on Hurd
		pam-auth-update --package --remove runit-user-session
	fi
fi

#TODO: should we stop the rusnvdir user instance here? but it
# will destroy the session where apt is operating...

#DEBHELPER#

exit 0
