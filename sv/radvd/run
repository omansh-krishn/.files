exec 2>&1

[ -r /etc/radvd.conf ] || exit 170

${XCHPST:+xchpst --file xchopts.configtest} ##bin## --configtest || exit 162
exec ${XCHPST:-} ##bin## --nodaemon --username radvd --logmethod stderr_clean
