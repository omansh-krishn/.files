#modprobe snd_pcm_oss

#nasd fails if audio device is busy
if fuser /dev/snd/* ; then
	echo "  ${PWD##*/}: audio device is busy, stopping the service"
	sv d "${PWD}"
fi

exec 2>&1

exec ##bin##
