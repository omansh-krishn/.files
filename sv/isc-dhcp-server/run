#        2024 Andrew Bower <andrew@bower.uk>
#License: BSD-3-Clause

exec 2>&1

[ -n "$INTERFACESv4" ] || {
  echo "invoke-run: no IPv4 interfaces specified for ${PWD##*/}"
  exit 162
}

leases="/var/lib/dhcp/dhcpd.leases"
[ -e "$leases" ] || touch "$leases"

##bin## -4 -f -d -t $INTERFACESv4 || exit 162
##bin## -4 -f -d -T $INTERFACESv4 || exit 162

if [ -e /etc/runit/verbose ]; then
	echo "invoke-run: starting ${PWD##*/}"
fi

exec ##bin## -4 -f -d $INTERFACESv4
