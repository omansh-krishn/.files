exec 2>&1

dhcpd -4 -f -d -t $INTERFACESv4 || exit 162
dhcpd -4 -f -d -T $INTERFACESv4 || exit 162

if [ -e /etc/runit/verbose ]; then
	echo "invoke-run: starting ${PWD##*/}"
fi

exec dhcpd -4 -f -d $INTERFACESv4
